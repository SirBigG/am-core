# Copy this file to database-backup.env and keep that file secret.
# The concrete database-backup.env file is ignored by Git.

SPACES_DESTINATION_URI=s3://your-private-space/database
SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
SPACES_REGION=fra1

# This remains a separate raw 32-byte file; do not paste the key into this env file.
SPACES_SSE_C_KEY_FILE=/secure/path/agromega-spaces-backup.key

# Prefer a deployment secret manager. These placeholders are not real credentials.
SPACES_ACCESS_KEY_ID=replace-with-spaces-access-key
SPACES_SECRET_ACCESS_KEY=replace-with-spaces-secret-key

# Optional when the Compose file is not in the directory where the command runs.
# COMPOSE_FILE=/absolute/path/to/docker-compose.yml

# Optionally pin an approved AWS CLI v2 container image for production.
# AWS_CLI_IMAGE=amazon/aws-cli:2.36.10

# Optional object filename prefix.
BACKUP_PREFIX=am-core
